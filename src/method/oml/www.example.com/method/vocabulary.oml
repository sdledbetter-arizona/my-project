@dc:title "My Project Vocabulary"
@dc:description "The My Project ontologies."
vocabulary <http://www.example.com/method/vocabulary#> as method {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2001/XMLSchema#> as xsd


    // BASE SETUP

    @dc:description "Reusable traits that concepts can share."
    aspect Identified


    @dc:description "Name of an Identified element."
    scalar property itemName [
        domain Identified
        range xsd:string
        functional
    ]


    @dc:description "Description of an Identified element."
    scalar property itemDescription [
        domain Identified
        range xsd:string
        functional
    ]

    scalar property id [
        domain Identified
        range xsd:string
        functional
    ]


    @dc:description "An example concept — replace it with your own domain type."
    concept Component < Identified


    @dc:description "An example relation linking a Component to one it depends on."
    relation dependsOn [
        from Component
        to Component
        reverse dependedOnBy
    ]


    // IDENTITIES

    @dc:description "The class of identities"
    concept Identity < Component [
        restricts identityType to exactly 1 identityTypes
    ]


    @dc:description "The scalar property indicating the types of an identity"
    scalar identityTypes [
        oneOf "Machine", "Human", "Agent"
    ]


    @dc:description "The identity type property of an identity"
    scalar property identityType [
        domain Identity
        range identityTypes
        functional
    ]


    @dc:description "The class of machine identities"
    concept MachineIdentity = Identity [
        restricts identityType to "Machine"
    ]


    @dc:description "The class of human identities"
    concept HumanIdentity = Identity [
        restricts identityType to "Human"
    ]


    @dc:description "The class of agent identities"
    concept AgentIdentity = Identity [
        restricts identityType to "Agent"
    ]


    // ACCOUNTS

    @dc:description "The class of accounts"
    concept Account < Component [
        restricts isCorrelated to exactly 1
        restricts nativeIdentity to exactly 1
        restricts isAccountOf to exactly 1
    ]


    @dc:description "The relation from Account to Identity"
    relation correlatesTo [
        from Account
        to Identity
        reverse isCorrelatedTo
        functional
    ]


    @dc:description "The relation from Account to Entitlement"
    relation holdsEntitlement [
        from Account
        to Entitlement
        reverse heldBy
    ]


    @dc:description "Scalar property indicating whether an account is correlated to an identity"
    scalar property isCorrelated [
        domain Account
        range xsd:boolean
    ]

    scalar property nativeIdentity [
        domain Account
        range xsd:string
        functional
    ]


    @dc:description "The class of orphan accounts"
    concept OrphanAccount = Account [
        restricts isCorrelated to false
    ]


    // ENTITLEMENTS
    
    @dc:description "The class of entitlements"
    concept Entitlement < Component [
        restricts isEntitlementOf to exactly 1
    ]


    // ROLES

    @dc:description "The class of roles"
    concept Role < Component


    @dc:description "The relation from Role to Entitlement"
    relation containsEntitlement [
        from Role
        to Entitlement
        reverse isEntitlementContainedIn
    ]

    @dc:description "The relation from Role to AccessProfile"
    relation containsAccessProfile [
        from Role
        to AccessProfile
        reverse isAccessProfileContainedIn
    ]


    // ACCESS PROFILES

    @dc:description "The class of access profiles"
    concept AccessProfile < Component [
        restricts belongsToApplicationSource to max 1
    ]


    @dc:description "The relation from AccessProfile to Entitlement"
    relation bundles [
        from AccessProfile
        to Entitlement
        reverse isBundledBy
    ]


    @dc:description "The relation from AccessProfile to ApplicationSource"
    relation belongsToApplicationSource [
        from AccessProfile
        to ApplicationSource
        reverse sourceForAccessProfile
        functional
    ]


    // APPLICATION SOURCES

    @dc:description "The class of application sources"
    concept ApplicationSource < Component 


    @dc:description "The relation from ApplicationSource to Entitlement"
    relation hasEntitlement [
        from ApplicationSource
        to Entitlement
        reverse isEntitlementOf
        inverse functional
    ]


    @dc:description "The relation from ApplicationSource to Account"
    relation hasAccount [
        from ApplicationSource
        to Account
        reverse isAccountOf
        inverse functional
    ]
}
