@dc:title "Application Sources"
@dc:description "Description of Application Sources for my project."
description <http://www.example.com/project/connections/application-sources#> as application-sources {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    uses <http://www.example.com/method/application-source#> as application
    extends <http://www.example.com/project/identity-management/accounts#> as accounts
    extends <http://www.example.com/project/access-models/entitlements#> as entitlements

    instance ApplicationSource1 : application:ApplicationSource [
        base:itemName "Active Directory"
        base:itemDescription "Active Directory is a directory service developed by Microsoft for Windows domain networks."
        application:hasEntitlement entitlements:Entitlement1, entitlements:Entitlement2, entitlements:Entitlement3
        application:hasAccount accounts:Account1, accounts:Account2, accounts:Account22
    ]

    instance ApplicationSource2 : application:ApplicationSource [
        base:itemName "Dropbox"
        base:itemDescription "Dropbox is a cloud storage service that allows users to store and sync files across devices."
        application:hasEntitlement entitlements:Entitlement4, entitlements:Entitlement5
        application:hasAccount accounts:Account3, accounts:Account4
    ]

    instance ApplicationSource3 : application:ApplicationSource [
        base:itemName "DocuSign"
        base:itemDescription "A cloud-based software platform that allows people and businesses to sign, send, and manage legal documents and contracts electronically."
        application:hasAccount accounts:Account5, accounts:Account6, accounts:Account7
        application:hasEntitlement entitlements:Entitlement7, entitlements:Entitlement6
    ]

    instance ApplicationSource4 : application:ApplicationSource [
        base:itemName "Salesforce"
        base:itemDescription "A customer relationship management platform for managing sales, customer service, and business data."
        application:hasAccount accounts:Account8, accounts:Account9, accounts:Account13, accounts:Account14, accounts:Account15, accounts:Account23
        application:hasEntitlement entitlements:Entitlement8, entitlements:Entitlement9
    ]

    instance ApplicationSource5 : application:ApplicationSource [
        base:itemName "ServiceNow"
        base:itemDescription "A cloud platform for IT service management, service requests, and enterprise workflows."
        application:hasAccount accounts:Account10, accounts:Account16, accounts:Account17, accounts:Account18, accounts:Account24
        application:hasEntitlement entitlements:Entitlement10, entitlements:Entitlement11
    ]

    instance ApplicationSource6 : application:ApplicationSource [
        base:itemName "GitHub"
        base:itemDescription "A software development platform for hosting repositories and collaborating on source code."
        application:hasAccount accounts:Account11, accounts:Account12, accounts:Account19, accounts:Account20, accounts:Account21
        application:hasEntitlement entitlements:Entitlement12, entitlements:Entitlement13
    ]

    instance ApplicationSource7 : application:ApplicationSource [
        base:itemName "Confluence"
        base:itemDescription "A team collaboration wiki with configured entitlements but no accounts connected."
        application:hasEntitlement entitlements:Entitlement14, entitlements:Entitlement15
    ]

    instance ApplicationSource8 : application:ApplicationSource [
        base:itemName "Workday HR"
        base:itemDescription "A human resources system with connected accounts but no entitlements configured."
        application:hasAccount accounts:Account25, accounts:Account26
    ]
}
