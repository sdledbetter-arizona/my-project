@dc:title "Access Profiles"
@dc:description "Description of Access Profiles for my project."
description <http://www.example.com/project/access-models/access-profiles#> as access-profiles {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    extends <http://www.example.com/project/access-models/entitlements#> as entitlements
    extends <http://www.example.com/project/connections/application-sources#> as applications
    uses <http://www.example.com/method/access-profile#> as access-profile

    instance AccessProfile1 : access-profile:AccessProfile [
        base:itemName "Citrix Access"
        base:itemDescription "Access to Citrix applications and resources."
        access-profile:belongsToApplicationSource applications:ApplicationSource1
        access-profile:bundles entitlements:Entitlement2
    ]

    instance AccessProfile2 : access-profile:AccessProfile [
        base:itemName "Basic Dropbox Access"
        base:itemDescription "Access to Dropbox cloud storage."
        access-profile:belongsToApplicationSource applications:ApplicationSource2
        access-profile:bundles entitlements:Entitlement4
    ]

    instance AccessProfile3 : access-profile:AccessProfile [
        base:itemName "Sales Cloud Standard Access"
        base:itemDescription "Standard Salesforce sales access with reporting capabilities."
        access-profile:belongsToApplicationSource applications:ApplicationSource4
        access-profile:bundles entitlements:Entitlement8, entitlements:Entitlement9, entitlements:Entitlement1
    ]

    instance AccessProfile4 : access-profile:AccessProfile [
        base:itemName "ServiceNow Service Desk Access"
        base:itemDescription "IT service management and service request access."
        access-profile:belongsToApplicationSource applications:ApplicationSource5
        access-profile:bundles entitlements:Entitlement10, entitlements:Entitlement11
    ]

    instance AccessProfile5 : access-profile:AccessProfile [
        base:itemName "GitHub Developer Access"
        base:itemDescription "Organization membership for software development."
        access-profile:belongsToApplicationSource applications:ApplicationSource6
        access-profile:bundles entitlements:Entitlement12
    ]

    instance AccessProfile6 : access-profile:AccessProfile [
        base:itemName "GitHub Repository Administration"
        base:itemDescription "Administrative access for managing GitHub repositories."
        access-profile:belongsToApplicationSource applications:ApplicationSource6
        access-profile:bundles entitlements:Entitlement13
    ]

    instance AccessProfile7 : access-profile:AccessProfile [
        base:itemName "Confluence Access - Unconfigured"
        base:itemDescription "Placeholder access profile with no bundled entitlements yet."
        access-profile:belongsToApplicationSource applications:ApplicationSource7
    ]

    instance AccessProfile8 : access-profile:AccessProfile [
        base:itemName "Workday HR Access - Unconfigured"
        base:itemDescription "Placeholder access profile with no bundled entitlements yet."
        access-profile:belongsToApplicationSource applications:ApplicationSource8
    ]
}
