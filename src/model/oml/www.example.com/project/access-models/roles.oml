@dc:title "Roles"
@dc:description "Description of Roles for my project."
description <http://www.example.com/project/access-models/roles#> as roles {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    extends <http://www.example.com/project/access-models/entitlements#> as entitlements
    extends <http://www.example.com/project/access-models/access-profiles#> as access-profiles
    uses <http://www.example.com/method/role#> as role

    instance Role1 : role:Role [
        base:itemName "Systems Administrator"
        base:itemDescription "Responsible for managing and maintaining access for all applications."
        role:containsEntitlement entitlements:Entitlement1, entitlements:Entitlement5
    ]

    instance Role2 : role:Role [
        base:itemName "HR Analyst"
        base:itemDescription "Basic HR functions and responsibilities."
        role:containsAccessProfile access-profiles:AccessProfile2
    ]

    instance Role3 : role:Role [
        base:itemName "Sales Operations Analyst"
        base:itemDescription "Sales operations access for customer records and report exports."
        role:containsAccessProfile access-profiles:AccessProfile3
    ]

    instance Role4 : role:Role [
        base:itemName "IT Service Desk Analyst"
        base:itemDescription "Access to triage service requests and manage IT service workflows."
        role:containsAccessProfile access-profiles:AccessProfile4
    ]

    instance Role5 : role:Role [
        base:itemName "Software Engineer"
        base:itemDescription "GitHub organization access for software development."
        role:containsAccessProfile access-profiles:AccessProfile5
    ]

    instance Role6 : role:Role [
        base:itemName "Repository Administrator"
        base:itemDescription "Elevated access for managing repository configuration and permissions."
        role:containsAccessProfile access-profiles:AccessProfile6
    ]

    instance Role7 : role:Role [
        base:itemName "Unconfigured Confluence Role"
        base:itemDescription "Placeholder role with no entitlements or access profiles assigned yet."
    ]

    instance Role8 : role:Role [
        base:itemName "Unconfigured HR Role"
        base:itemDescription "Placeholder role with no entitlements or access profiles assigned yet."
    ]
}
